# AAPM Medical Physics submission style.
#
# Three of the journal's requirements cannot be expressed as rcParams:
# outward major ticks with inward minor ticks, round tick intervals, and one
# decimal-place count per axis.
#
# Column widths are 80 mm (single) and 180 mm (double); a typeset figure is
# not rescaled. Line art needs 600 dpi, photographic images 300 dpi.

font.family: sans-serif
font.sans-serif: Arial, Helvetica, Calibri, DejaVu Sans
font.size: 10
mathtext.fontset: dejavusans

axes.titlesize: 10
axes.labelsize: 10
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', '56B4E9', 'E69F00'])

grid.color: B4B4B4
grid.linewidth: 0.6

xtick.labelsize: 10
ytick.labelsize: 10
xtick.direction: out
ytick.direction: out
xtick.major.size: 4
ytick.major.size: 4
xtick.minor.size: 2.2
ytick.minor.size: 2.2
xtick.minor.visible: True
ytick.minor.visible: True

lines.linewidth: 1.6
lines.markersize: 5
lines.markeredgewidth: 0

patch.linewidth: 0.9

legend.fontsize: 10
legend.frameon: False
legend.borderaxespad: 0.3
legend.handlelength: 1.8
legend.handletextpad: 0.5

figure.figsize: 3.149606, 2.362205
figure.dpi: 300
figure.constrained_layout.use: True

savefig.dpi: 600
# Save at the exact 80 mm authored width; a tight crop changes it.
savefig.bbox: standard

image.interpolation: nearest

pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
